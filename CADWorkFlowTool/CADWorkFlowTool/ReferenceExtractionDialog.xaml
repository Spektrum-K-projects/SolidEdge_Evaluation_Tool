<Window x:Class="CADWorkFlowTool.ReferenceExtractionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference XML Extraction" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" >
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input folder (2.a Evaluation Reference Model) -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="2.a Evaluation Reference Model (Input Folder)" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRefInput" Padding="6" MinWidth="420"/>
                <Button x:Name="BtnBrowseRefInput" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="10,6"/>
            </Grid>
        </StackPanel>

        <!-- Output folder (4. Reference XML Files) -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <TextBlock Text="4. Reference XML Files (Output Folder)" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRefOutput" Padding="6" MinWidth="420"/>
                <Button x:Name="BtnBrowseRefOutput" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="10,6"/>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnCancelRefExtract" Content="Cancel" Padding="10,6" Margin="0,0,8,0"/>
            <Button x:Name="BtnRunRefExtract" Content="Run Extraction" Padding="12,6" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>