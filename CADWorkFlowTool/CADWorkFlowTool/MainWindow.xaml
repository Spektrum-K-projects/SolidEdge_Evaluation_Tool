<Window x:Class="CADWorkFlowTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CADWorkFlowTool"
        mc:Ignorable="d"
        Title="CAD Comparison Tool: SolidEdge" Height="700" Width="800">
    <Grid>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Stepper -->
                <RowDefinition Height="*" />
                <!-- Step Content -->
                <RowDefinition Height="Auto" />
                <!-- Log Header + Save Button -->
                <RowDefinition Height="250" />
                <!-- Log Window -->
            </Grid.RowDefinitions>

            <!-- Stepper (Simple Text Version) -->
            <TextBlock Grid.Row="0" x:Name="StepperText" Text="Step 1 of 3: Preprocessor" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

            <!-- Step Content Area -->
            <Grid Grid.Row="1">
                <!-- Step 1: Preprocessor -->
                <StackPanel x:Name="Step1_Preprocessor" Visibility="Visible">
                    <Label Content="1. Input Folder (Files extracted from Server)" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPreprocessorInput" Padding="5" />
                        <Button x:Name="BtnBrowsePreInput" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,5" />
                    </Grid>
                    <Label Content="2. Pre-Processed Files" Margin="0,10,0,0" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPreprocessorOutput" Padding="5" ToolTip="Required only if running the preprocessor."/>
                        <Button x:Name="BtnBrowsePreOutput" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,5" />
                    </Grid>
                    <!-- Navigation for Step 1 -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Takes up remaining space -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Size to content -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Size to content -->
                        </Grid.ColumnDefinitions>

                        <!-- Skip Button -->
                        <Button x:Name="BtnSkipPreprocessor" Grid.Column="1" Content="Skip Preprocessor →" HorizontalAlignment="Right" Padding="15,10" Margin="0,0,10,0" ToolTip="Use the Input Folder directly for Step 2." />

                        <!-- Run Button -->
                        <Button x:Name="BtnRunPreprocessor" Grid.Column="2" Content="Run Preprocessor →" HorizontalAlignment="Right" Padding="15,10" FontWeight="Bold" Background="#007ACC" Foreground="White" />
                        <!-- No Previous Button on Step 1 -->
                    </Grid>
                </StackPanel>

                <!-- Step 2: Data Extraction -->
                <StackPanel x:Name="Step2_Extraction" Visibility="Collapsed">
                    <Label Content="2. Pre-Processed Files" FontWeight="Bold"/>
                    <TextBox x:Name="TxtExtractionInput" Padding="5" IsReadOnly="True" Background="#EEE" />
                    <Label Content="3. Student XML Files" Margin="0,10,0,0" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- MODIFIED: ToolTip added for clarity when skipping -->
                        <TextBox x:Name="TxtExtractionOutput" Padding="5" ToolTip="Enter the path containing existing XMLs if skipping this step." />
                        <Button x:Name="BtnBrowseExOutput" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,5" />
                    </Grid>
                    <!-- Navigation for Step 2 -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Previous Button -->
                            <ColumnDefinition Width="*"/>
                            <!-- Spacer -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Skip Button -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Run Button -->
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPreviousToStep1" Grid.Column="0" Content="← Previous" HorizontalAlignment="Left" Padding="15,10" />
                        <!-- NEW: Skip Button Added -->
                        <Button x:Name="BtnSkipExtraction" Grid.Column="2" Content="Skip Extraction →" HorizontalAlignment="Right" Padding="15,10" Margin="0,0,10,0" ToolTip="Use the Output Folder path directly for Step 3."/>
                        <Button x:Name="BtnRunExtraction" Grid.Column="3" Content="Run Extraction →" HorizontalAlignment="Right" Padding="15,10" FontWeight="Bold" Background="#007ACC" Foreground="White" />
                    </Grid>
                </StackPanel>

                <!-- Step 3: XML Comparison -->
                <StackPanel x:Name="Step3_Comparison" Visibility="Collapsed">
                    <!-- MODIFIED: Label text updated -->
                    <Label Content="3. Student XML Files" FontWeight="Bold" />
                    <TextBox x:Name="TxtComparisonInput" Padding="5" IsReadOnly="True" Background="#EEE" />
                    <Label Content="4. Reference XML FIles" Margin="0,10,0,0" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtComparisonBaseline" Padding="5" />
                        <Button x:Name="BtnBrowseCmpBaseline" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,5" />
                    </Grid>
                    <Label Content="5. Comparison Report Output Folder" Margin="0,10,0,0" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtComparisonOutput" Padding="5" />
                        <Button x:Name="BtnBrowseCmpOutput" Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Padding="10,5" />
                    </Grid>
                    <!-- Navigation for Step 3 -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPreviousToStep2" Grid.Column="0" Content="← Previous" HorizontalAlignment="Left" Padding="15,10" />
                        <Button x:Name="BtnRunComparison" Grid.Column="1" Content="Run Comparison &amp; Finish" HorizontalAlignment="Right" Padding="15,10" FontWeight="Bold" Background="#009933" Foreground="White" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Log Header + Save Button -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Log Output" FontWeight="Bold" />
                <!-- Spacer -->
                <StackPanel Grid.Column="1" />
                <!-- Reference Extraction button (always available) -->
                <Button Grid.Column="2" x:Name="BtnRunRefExtraction" Content="Reference XML Extract..." HorizontalAlignment="Right" Padding="10,3" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Run xml_data_extraction on the Evaluation Reference Models (2.a) to produce Reference XMLs (4.)" FontWeight="Bold" Background="#007ACC" Foreground="White" />
                <Button Grid.Column="3" x:Name="BtnSaveLog" Content="Save Log..." HorizontalAlignment="Right" Padding="10,3" VerticalAlignment="Center" Margin="0,0,5,0" />
            </Grid>

            <!-- Log Window -->
            <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#2B2B2B" Foreground="#CCC" FontFamily="Consolas" Padding="5" />
        </Grid>
    </Grid>
</Window>
